{
  "expo": {
    "name": "Booostr POS",
    "slug": "booostr-pos-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#00c0ff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.booostr.pos",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "Booster.chat.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00c0ff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
