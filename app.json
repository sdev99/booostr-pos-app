{
  "expo": {
    "name": "Booostr POS",
    "slug": "booostr-pos-app",
    "version": "1.2.3",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#03cb8a"
    },
    "owner": "sdev99",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.booostr.pos",
      "buildNumber": "16",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "To scan cards."
      }
    },
    "android": {
      "package": "com.booostr.pos",
      "version": "1.0.1",
      "versionCode": 5,
      "enableEdgeToEdge": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#03cb8a"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "1e993bd0-906f-4b74-9047-36c3289a14ec"
      }
    },
    "runtimeVersion": "1.2.3",
    "updates": {
      "url": "https://u.expo.dev/1e993bd0-906f-4b74-9047-36c3289a14ec"
    },
    "plugins": [
      "./plugins/withPackagingOptions",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "useLegacyPackaging": false,
            "minSdkVersion": 26,
            "targetSdkVersion": 35,
            "enableJetifier": true
          }
        }
      ],
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": true,
          "locationWhenInUsePermission": "Location access is required in order to accept payments.",
          "bluetoothPeripheralPermission": "Bluetooth access is required in order to connect to supported bluetooth card readers.",
          "bluetoothAlwaysUsagePermission": "This app uses Bluetooth to connect to supported card readers."
        }
      ],
      "expo-sqlite",
      "expo-font"
    ]
  }
}
